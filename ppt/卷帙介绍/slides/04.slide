<Slide style={{ width: 1280, height: 720, background: '#FDFBF7', padding: 60 }}>
    {/* 标题区 */}
    <Animation animType="fadeIn" duration={500} startType="afterPrevious">
        <Box>
            <Text style={{ fontFamily: 'KaiTi, STKaiti, serif', fontSize: 36, fontWeight: 'bold', color: '#1A1A1A' }}>世界观：一张能拖动的舆图</Text>
            <Box style={{ width: '100%', height: 1, background: '#C9A961', marginTop: 12, marginBottom: 8 }} />
        </Box>
    </Animation>
    {/* 主体：左要点 + 右截图（镜像 P3） */}
    <Box style={{ flexDirection: 'row', height: 470, marginTop: 18, gap: 34 }}>
        <Box style={{ flex: 1, justifyContent: 'center', gap: 24 }}>
            <Animation animType="fadeIn" duration={500}>
                <Box>
                    <Text style={{ fontFamily: 'KaiTi, STKaiti, serif', fontSize: 24, color: '#9B2C2C', marginBottom: 6 }}>多位面并存</Text>
                    <Text style={{ fontFamily: 'Microsoft YaHei, sans-serif', fontSize: 17, color: '#4A443C', lineHeight: 1.6 }}>每个位面各自一份舆图，互不打架</Text>
                </Box>
            </Animation>
            <Animation animType="fadeIn" duration={500} startType="afterPrevious">
                <Box>
                    <Text style={{ fontFamily: 'KaiTi, STKaiti, serif', fontSize: 24, color: '#9B2C2C', marginBottom: 6 }}>宗门节点可拖动</Text>
                    <Text style={{ fontFamily: 'Microsoft YaHei, sans-serif', fontSize: 17, color: '#4A443C', lineHeight: 1.6 }}>摆好位置，关系线实时重绘</Text>
                </Box>
            </Animation>
            <Animation animType="fadeIn" duration={500} startType="afterPrevious">
                <Box>
                    <Text style={{ fontFamily: 'KaiTi, STKaiti, serif', fontSize: 24, color: '#9B2C2C', marginBottom: 6 }}>修为体系</Text>
                    <Text style={{ fontFamily: 'Microsoft YaHei, sans-serif', fontSize: 17, color: '#4A443C', lineHeight: 1.6 }}>境界条目就地可改，设定不再散落草稿</Text>
                </Box>
            </Animation>
        </Box>
        <Animation animType="zoom" duration={700} startType="afterPrevious">
            <Box style={{ width: 660, padding: 8, background: '#FFFFFF', border: '1px solid #C9A961', borderRadius: 10 }}>
                <Image src="assets/world.png" style={{ width: 644, height: 362, objectFit: 'cover', borderRadius: 6 }} />
            </Box>
        </Animation>
    </Box>
    <Box style={{ position: 'absolute', left: 60, bottom: 22 }}>
        <Text style={{ fontFamily: 'Microsoft YaHei, sans-serif', fontSize: 14, color: '#A79E92' }}>卷帙 NovelFolio · 04</Text>
    </Box>
</Slide>
