<Slide style={{ width: 1280, height: 720, background: '#FDFBF7', padding: 60 }}>
    {/* 标题区 */}
    <Animation animType="fadeIn" duration={500} startType="afterPrevious">
        <Box>
            <Text style={{ fontFamily: 'KaiTi, STKaiti, serif', fontSize: 36, fontWeight: 'bold', color: '#1A1A1A' }}>人物：每个角色都有据可查</Text>
            <Box style={{ width: '100%', height: 1, background: '#C9A961', marginTop: 12, marginBottom: 8 }} />
        </Box>
    </Animation>
    {/* 主体 */}
    <Box style={{ flexDirection: 'row', height: 470, marginTop: 18, gap: 34 }}>
        {/* 左：截图 */}
        <Animation animType="fadeIn" duration={700}>
            <Box style={{ width: 660, padding: 8, background: '#FFFFFF', border: '1px solid #C9A961', borderRadius: 10 }}>
                <Image src="assets/characters.png" style={{ width: 644, height: 362, objectFit: 'cover', borderRadius: 6 }} />
            </Box>
        </Animation>
        {/* 右：要点 */}
        <Box style={{ flex: 1, justifyContent: 'center', gap: 24 }}>
            <Animation animType="fadeIn" duration={500} startType="afterPrevious">
                <Box>
                    <Text style={{ fontFamily: 'KaiTi, STKaiti, serif', fontSize: 24, color: '#9B2C2C', marginBottom: 6 }}>立绘与人设字段</Text>
                    <Text style={{ fontFamily: 'Microsoft YaHei, sans-serif', fontSize: 17, color: '#4A443C', lineHeight: 1.6 }}>年龄、身份、修为、结局，点进字段直接改</Text>
                </Box>
            </Animation>
            <Animation animType="fadeIn" duration={500} startType="afterPrevious">
                <Box>
                    <Text style={{ fontFamily: 'KaiTi, STKaiti, serif', fontSize: 24, color: '#9B2C2C', marginBottom: 6 }}>三态情节时间轴</Text>
                    <Text style={{ fontFamily: 'Microsoft YaHei, sans-serif', fontSize: 17, color: '#4A443C', lineHeight: 1.6 }}>悬停看摘要、点击看详情，牵出相关章节</Text>
                </Box>
            </Animation>
            <Animation animType="fadeIn" duration={500} startType="afterPrevious">
                <Box>
                    <Text style={{ fontFamily: 'KaiTi, STKaiti, serif', fontSize: 24, color: '#9B2C2C', marginBottom: 6 }}>废案篓可回收</Text>
                    <Text style={{ fontFamily: 'Microsoft YaHei, sans-serif', fontSize: 17, color: '#4A443C', lineHeight: 1.6 }}>删掉的角色进篓，随时找回，Ctrl+Z 也能撤</Text>
                </Box>
            </Animation>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 60, bottom: 22 }}>
        <Text style={{ fontFamily: 'Microsoft YaHei, sans-serif', fontSize: 14, color: '#A79E92' }}>卷帙 NovelFolio · 03</Text>
    </Box>
</Slide>
